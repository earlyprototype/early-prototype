{
  "description": "coachtime (coach) hooks. Capture hooks — history mirror (PostToolUse) + intent capture (SessionStart/UserPromptSubmit) — gate on a `.coachtime` project marker. The drift flag (PreToolUse) gates on the per-session coach-session-<shortId>.txt marker. NO PM/Worker hooks here — worker-completion-signal and pm-handoff-discovery ship with the early-prototype suite plugin.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/coach-intent-capture.js\" start",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/coach-intent-capture.js\" prompt",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/coach-history-mirror.js\"",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/coach-drift-flag.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
