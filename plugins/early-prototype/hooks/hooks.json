{
  "description": "timeteam (early-prototype) PM/Worker lifecycle hooks. Registers the Stop hook that drops handoffs and the SessionStart hook that surfaces unread handoffs.",
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/worker-completion-signal.js\"",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/pm-handoff-discovery.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
